{
  "language": "ar",
  "whisper_model": "large-v3",
  "output": {
    "width": 1080,
    "height": 1920,
    "fps": 30,
    "crf": 19
  },
  "cuts": {
    "min_gap": 0.45,
    "pad": 0.1,
    "min_seg": 0.35
  },
  "motion": {
    "enabled": true,
    "zoom_cycle": [
      1.0,
      1.1,
      1.04,
      1.14
    ],
    "pan_px": 26,
    "zoom_every": 2.5
  },
  "geometry": {
    "fit": "crop",
    "crop_bias": 0.5,
    "pad_blur": 24,
    "tonemap": "mobius",
    "tonemap_npl": 700
  },
  "captions": {
    "enabled": true,
    "font": "fonts/Tajawal-ExtraBold.ttf",
    "size": 45,
    "max_words": 3,
    "color": [
      255,
      255,
      255
    ],
    "highlight": [
      255,
      92,
      58
    ],
    "karaoke": false,
    "box": [
      114,
      18,
      13,
      255
    ],
    "y_ratio": 0.64
  },
  "sfx": {
    "enabled": false,
    "min_gap": 0.12,
    "speech_gain": 0.7,
    "events": {
      "start": {
        "asset": "impact",
        "gain": 0.3,
        "enabled": true
      },
      "finale": {
        "asset": "riser",
        "gain": 0.22,
        "enabled": true
      },
      "cut": {
        "asset": "whoosh",
        "gain": 0.22,
        "enabled": true
      },
      "zoom": {
        "asset": "whoosh",
        "gain": 0.18,
        "enabled": true
      },
      "caption": {
        "asset": "pop",
        "gain": 0.25,
        "enabled": true
      },
      "word": {
        "asset": "tick",
        "gain": 0.12,
        "enabled": false
      }
    }
  },
  "exports": {
    "reel": {},
    "square": {
      "output": {
        "width": 1080,
        "height": 1080
      },
      "captions": {
        "size": 44,
        "y_ratio": 0.8
      },
      "geometry": {
        "crop_bias": 0.25
      }
    },
    "wide": {
      "output": {
        "width": 1920,
        "height": 1080
      },
      "captions": {
        "size": 44,
        "y_ratio": 0.82
      },
      "geometry": {
        "fit": "pad"
      }
    }
  }
}
